# ==============================================================================
# ApoCare Healthcare Platform - Environment Configuration
# ==============================================================================

# Database Configuration (MySQL / phpMyAdmin)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=apocare_db

# Application Configuration
APP_NAME=ApoCare
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/hospital%20management%20system

# Security
APP_SECRET=apocare_secure_jwt_session_token_2026_super_key_!99

# Payment Gateway (Razorpay)
# Set MOCK_PAYMENT_MODE=true for local hackathon demo without Razorpay account
MOCK_PAYMENT_MODE=true
RAZORPAY_KEY_ID=rzp_test_YourKeyHere123
RAZORPAY_KEY_SECRET=YourSecretKeyHere456
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecret789

# Map Integration
GOOGLE_MAPS_API_KEY=AIzaSyYourMapKeyPlaceholder
DEFAULT_LATITUDE=23.2324
DEFAULT_LONGITUDE=87.0715
DEFAULT_LOCATION=Bankura
